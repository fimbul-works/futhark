{
  "name": "@fimbul-works/futhark",
  "description": "Encode and decode numbers using a custom alphabet, such as Base-62 and Futhark runes.",
  "version": "1.0.0",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "FimbulWorks <contact@fimbul.works>",
  "homepage": "https://github.com/fimbul-works/futhark#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fimbul-works/futhark.git"
  },
  "bugs": {
    "url": "https://github.com/fimbul-works/futhark/issues"
  },
  "keywords": [
    "radix",
    "base62",
    "base-62",
    "encode",
    "encoding",
    "decode",
    "decoding",
    "alphabet",
    "typescript"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsdown",
    "test": "vitest",
    "format": "npx biome format --write src",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
